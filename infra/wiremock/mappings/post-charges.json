{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/charges",
    "bodyPatterns": [{ "matchesJsonPath": { "expression": "$.token", "equalTo": "tok_ok" } }]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "status": "APPROVED", "gateway_ref": "gw-{{jsonPath request.body '$.reference'}}" }
  }
}
